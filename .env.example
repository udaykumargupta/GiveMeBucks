# Copy to .env (git-ignored) and fill in. The server reads it on start.
# Leave GOOGLE_CLIENT_ID empty to run without sign-in (single user, this Mac only).

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost:4180 and http://localhost
GOOGLE_CLIENT_ID=

# Signs your session tokens. Any random string of at least 32 characters:
#   openssl rand -base64 48
JWT_SECRET=

# Who may sign in (comma-separated). Leave empty to let any Google account sign in —
# each account then gets its own private, empty dashboard.
# The first allow-listed account to sign in takes over the data you entered before sign-in.
ALLOWED_EMAILS=

# Optional (defaults shown)
# JWT_EXPIRATION_MS=604800000   # session length: 7 days
# PORT=4180
